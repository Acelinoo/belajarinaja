# =========================================================================
# BelajarinAja - Environment Variables Configuration
# =========================================================================

# Database Connection (PostgreSQL)
# Contoh: postgresql://username:password@localhost:5432/belajarinaja?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/belajarinaja?schema=public"

# NextAuth Configuration
# Ganti NEXTAUTH_SECRET dengan random string 32 karakter
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="belajarinaja-super-secret-key-32-chars-long"

# Google OAuth Credentials (Dibuat di Google Cloud Console)
# Redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID="ISI_DENGAN_GOOGLE_CLIENT_ID_ANDA"
GOOGLE_CLIENT_SECRET="ISI_DENGAN_GOOGLE_CLIENT_SECRET_ANDA"

# GitHub OAuth Credentials (Dibuat di GitHub Developer Settings)
# Authorization callback URL: http://localhost:3000/api/auth/callback/github
GITHUB_CLIENT_ID="ISI_DENGAN_GITHUB_CLIENT_ID_ANDA"
GITHUB_CLIENT_SECRET="ISI_DENGAN_GITHUB_CLIENT_SECRET_ANDA"
